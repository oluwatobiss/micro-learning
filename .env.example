# Google Gemini API Key (Server-Only)
# Obtain a Gemini API key from Google AI Studio: https://aistudio.google.com/app/api-keys
# This key is strictly accessed by server-side routes and never exposed to the client browser.
GEMINI_API_KEY=your_gemini_api_key_here

# Configurable Gemini Model (Optional, defaults to gemini-3.8-flash)
# Supported options include: gemini-3.8-flash (recommended flagship stable), gemini-3.6-flash (stable), gemini-3.5-flash-lite, gemini-4-argon
# Note: Retired models (such as gemini-2.0-flash, gemini-1.5-flash, gemini-2.5-flash) return HTTP 404 from the Google API.
GEMINI_MODEL=gemini-3.8-flash

# Configurable Gemini Fallback Model (Optional, defaults to gemini-3.6-flash)
# Automatically attempted if the primary model encounters transient 503 capacity spikes after retries.
# Set to "none" to disable automatic fallback.
GEMINI_FALLBACK_MODEL=gemini-3.6-flash
